    {"type": "matching", "prompt": "Associe chaque nom à son sens.", "pairs": [["친구", "ami(e)"], ["옷", "vêtements"], ["날씨", "météo"], ["영화", "film"], ["질문", "question"], ["영어", "anglais (langue)"]], "explanation": "Unit 5, [명사]."},
    {"type": "mcq", "prompt": "Que veut dire 어디 ?", "choices": ["où", "quand", "quoi", "qui"], "explanation": "뭘 = quoi (= 무엇을)."},
