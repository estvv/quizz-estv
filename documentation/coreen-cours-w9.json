    {"type": "matching", "prompt": "Associe chaque mot de temps à son sens.", "pairs": [["지금", "maintenant"], ["오늘", "aujourd'hui"], ["내일", "demain"], ["요즘", "ces temps-ci"]], "explanation": "Unit 5, [시간]."},
