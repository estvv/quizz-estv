    {"type": "mcq", "prompt": "Que veut dire « 길이 복잡하다 » ?", "choices": ["La route est encombrée.", "Le chemin est long.", "Il fait doux.", "La route est fermée."], "explanation": "길 = route, 복잡하다 = être bondé."},
    {"type": "mcq", "prompt": "Pourquoi écrit-on 길이 mais 날씨가 ?", "choices": ["길 finit par une consonne (ㄹ), 날씨 par une voyelle", "C'est l'inverse de la règle", "길 est un verbe", "Les deux sont possibles"], "explanation": "이 après consonne, 가 après voyelle (S7)."},
    {"type": "mcq", "prompt": "Que veut dire 아주 ?", "choices": ["très", "et", "ne … pas", "nous"], "explanation": "그리고 = et, 안 = ne … pas, 우리 = nous."},
    {"type": "type_answer", "prompt": "Écris en hangeul le mot « nous » (u-ri).", "accept": ["우리"], "explanation": "우리 = nous / notre."}
