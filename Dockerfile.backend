FROM node:20-alpine AS builder

WORKDIR /app

# Install build dependencies for native modules (better-sqlite3)
RUN apk add --no-cache python3 make g++

# Force compiling better-sqlite3 from source instead of letting prebuild-install
# reach out to the network for a prebuilt binary — that fetch can hang/fail in
# a sandboxed Docker build, and we already have the toolchain to build it here.
ENV npm_config_build_from_source=true

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM node:20-alpine

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/src/db/schema.sql ./dist/db/schema.sql
COPY --from=builder /app/src/db/seed.json ./dist/db/seed.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

RUN mkdir -p /app/data

EXPOSE 8080

ENV DB_PATH=/app/data/quizz.db
ENV PORT=8080

CMD ["node", "dist/index.js"]
