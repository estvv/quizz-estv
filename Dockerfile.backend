FROM node:20-alpine AS builder

WORKDIR /app

# Build deps for the better-sqlite3 native module.
RUN apk add --no-cache python3 make g++

# Force compiling better-sqlite3 from source rather than letting prebuild-install
# reach the network for a prebuilt binary  that fetch can hang/fail in a
# sandboxed Docker build, and the toolchain is already here.
ENV npm_config_build_from_source=true

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build && npm prune --omit=dev

FROM node:20-alpine

RUN apk --no-cache add tzdata

WORKDIR /app

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/src/db/schema.sql ./dist/db/schema.sql
COPY --from=builder /app/src/db/seed.json ./dist/db/seed.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

RUN mkdir -p /app/data

# Runs as root so it can write the SQLite file into the bind-mounted ./data
# directory (owned by root on the host). The container is still tightly boxed by
# docker-compose: read-only root filesystem, all Linux capabilities dropped,
# no-new-privileges, and only /app/data + /tmp writable.

EXPOSE 8080

ENV DB_PATH=/app/data/quizz.db
ENV PORT=8080
ENV NODE_ENV=production

CMD ["node", "dist/index.js"]
